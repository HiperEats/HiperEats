# Copy to .env (never committed) and set your own password: cp .env.example .env
POSTGRES_DB=hipereats
POSTGRES_USER=hipereats
POSTGRES_PASSWORD=change-me
# Signs the access tokens (HE-28): at least 32 random characters, e.g. the output of
# openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
